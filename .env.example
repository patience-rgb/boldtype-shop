# Database
# For local dev: DATABASE_URL="file:./dev.db"
# For production (Supabase/Postgres): paste your connection string below
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# NextAuth — generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-string-here"
NEXTAUTH_URL="https://your-site.vercel.app"   # your deployed URL

# Stripe — add when ready to take real payments
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudinary — free image hosting for product photos
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Shipping API — add when ready
SHIPPING_API_KEY=""
SHIPPING_API_URL=""

# ─── Database ───────────────────────────────────────────────────────────────
# Supabase: Dashboard → Settings → Database → Connection string → URI tab
# Use the "Transaction pooler" URI for best performance on Vercel (serverless)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate secret: run  openssl rand -base64 32  in your terminal
NEXTAUTH_SECRET="your-generated-secret-here"
# Set to your actual Vercel URL after first deploy
NEXTAUTH_URL="https://your-site.vercel.app"

# ─── Cloudflare R2 (image uploads) ──────────────────────────────────────────
# Account ID:   Cloudflare dashboard → right sidebar
# API Token:    R2 → Manage R2 API Tokens → Create Token (Object Read & Write)
# Public URL:   R2 → your bucket → Settings → Public Access → Allow Access
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="boldtype-products"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# ─── Stripe (add when ready to take real payments) ───────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Shipping API (add when ready) ───────────────────────────────────────────
SHIPPING_API_KEY=""
SHIPPING_API_URL=""
